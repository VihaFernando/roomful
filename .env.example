# ---- Server (apps/server) ----
NODE_ENV=development            # development | production | test
HOST=0.0.0.0
PORT=3001
# Allowed browser origins for HTTP + WebSocket (comma-separated). Empty = allow same-origin only.
PUBLIC_ORIGIN=http://localhost:5173
# Serve the built web app (apps/web/dist) from the server for single-origin deploys.
SERVE_WEB_DIST=false
WEB_DIST_PATH=../web/dist
# Rooms & sessions
ROOM_CAPACITY=10
ROOM_EMPTY_TTL_MS=600000         # delete a room 10 min after the last player goes offline
ROOM_IDLE_TTL_MS=21600000        # delete any room idle for 6 h
PLAYER_RECONNECT_GRACE_MS=120000 # keep a disconnected player's seat for 2 min
HOST_TRANSFER_GRACE_MS=30000     # hand host to someone else after 30 s offline
# Read X-Forwarded-For for rate limiting (only when behind a trusted reverse proxy)
TRUST_PROXY=false
LOG_LEVEL=info                   # debug | info | warn | error

# ---- Web (apps/web) — only non-secret values; anything VITE_* ships to the browser ----
# Server URL used by the Vite dev proxy
VITE_DEV_SERVER_URL=http://localhost:3001
