{
  "name": "party-platform",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tests"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun run --filter @party/server dev",
    "dev:web": "bun run --filter @party/web dev",
    "test": "bun test",
    "typecheck": "bun scripts/typecheck.ts",
    "build": "bun run --filter @party/web build && bun run --filter @party/server build",
    "start": "bun run --filter @party/server start"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
